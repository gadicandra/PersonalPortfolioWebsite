# Copy to .env and adjust as needed.
# Local dev points at the Postgres container published on host port 5440.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5440/portfolio?schema=public"

# Contact-form email (Resend) — https://resend.com → API Keys.
# Optional: without it, messages save to Postgres but no email is sent.
RESEND_API_KEY=""
# The address notifications go to. With the default onboarding@resend.dev
# sender this MUST be your Resend account email.
CONTACT_TO_EMAIL=""
# Override the sender once you've verified a domain in Resend.
# CONTACT_FROM="Portfolio <hello@yourdomain.com>"
